# Public service
PUBLIC_WEB_URL=https://market.matrix-one.tech
DEFAULT_ORIGIN_ISO3=CHN
LATEST_COMPLETE_TRADE_YEAR=2025
TRADE_DATA_START_YEAR=2022
TRADE_DATA_END_YEAR=2026
MIN_MARKET_IMPORT_VALUE_USD=100000

# Shared provider behavior
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_DELAY_SECONDS=1

# UN Comtrade annual and monthly trade
# Live trade is the deployment default. Tests override this with fixture explicitly.
TRADE_DATA_PROVIDER=comtrade
COMTRADE_API_BASE_URL=https://comtradeapi.un.org/public/v1/preview
# Authenticated final-data endpoint; required for high-volume/all-HS extraction.
COMTRADE_FINAL_API_BASE_URL=https://comtradeapi.un.org/data/v1/get
COMTRADE_API_KEY=
COMTRADE_CACHE_TTL_DAYS=30
COMTRADE_MAX_CONCURRENCY=1
COMTRADE_BATCH_SIZE=25
COMTRADE_DATA_DIR=/data/comtrade

# World Bank country indicators (no API key required)
WORLD_BANK_API_BASE_URL=https://api.worldbank.org/v2
ENABLE_WORLD_BANK=true

# WITS / UNCTAD TRAINS tariffs (no API key required)
WITS_API_BASE_URL=https://wits.worldbank.org/API/V1/SDMX/V21
ENABLE_WITS=true

# WTO market-access and non-tariff data
# Register for a key at https://apiportal.wto.org/ before enabling.
WTO_API_KEY=
ENABLE_WTO=false

# Matrix One Supplier Network
SUPPLIER_API_BASE_URL=https://supplier.matrix-one.tech
SUPPLIER_API_KEY=
SUPPLIER_INTEGRATION_ENABLED=false
ENABLE_SUPPLIER=false
SUPPLIER_API_TIMEOUT_SECONDS=20

# eBay Browse API (official marketplace listing observations)
# Create production application keys at https://developer.ebay.com/.
EBAY_API_BASE_URL=https://api.ebay.com
EBAY_OAUTH_URL=https://api.ebay.com/identity/v1/oauth2/token
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Optional Matrix One authorized marketplace gateway for other marketplaces
# Used when eBay credentials above are empty.
MARKETPLACE_PROVIDER_CODE=
MARKETPLACE_API_BASE_URL=
MARKETPLACE_API_KEY=
MARKETPLACE_API_TIMEOUT_SECONDS=20

# EU Tenders Electronic Daily published procurement notices (no key required)
TED_API_BASE_URL=https://api.ted.europa.eu
ENABLE_TED=true

# Google Trends official API is limited-access alpha; apply before enabling.
# https://developers.google.com/search/apis/trends
ENABLE_GOOGLE_TRENDS=false

# Administration
ADMIN_EMAIL=admin@matrix-one.tech
ADMIN_PASSWORD=change-me
